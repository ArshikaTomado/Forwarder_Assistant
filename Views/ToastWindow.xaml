<!-- ToastWindow.xaml —— 自绘右下角提醒弹窗。
     完全不走系统通知，因此不受「系统通知总开关」影响，绿色便携可用。 -->
<Window x:Class="ForwarderAssistant.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="Height" Width="440"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- 卡片外边距留白：一是给阴影留出绘制空间，二是让卡片离屏幕边缘有呼吸感 -->
    <Border x:Name="Card" Margin="16,0,16,16" CornerRadius="10"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Cursor="Hand"
            MouseLeftButtonUp="OnCardClick"
            MouseEnter="OnCardMouseEnter"
            MouseLeave="OnCardMouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                              Color="#000000" Opacity="0.28" />
        </Border.Effect>
        <Grid Margin="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧强调色竖条：颜色随提醒级别变化（超时=红、待处理=橙…） -->
            <Border x:Name="AccentBar" Grid.Column="0" Width="5" CornerRadius="2"
                    VerticalAlignment="Stretch" Background="#0F6CBD" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BodyText" FontSize="13" Opacity="0.75"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
