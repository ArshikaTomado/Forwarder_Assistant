<!-- OverdueWindow.xaml —— 超时提醒详情窗：列出全部「超时未处理」节点，逐行「已处理 / 稍后处理」。 -->
<Window x:Class="ForwarderAssistant.Views.OverdueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="超时提醒" Width="640" SizeToContent="Height" MaxHeight="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" UseLayoutRounding="True">
    <Border Padding="18" Background="{DynamicResource ApplicationBackgroundBrush}">
        <StackPanel>
            <TextBlock Text="超时提醒" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" FontSize="12" Opacity="0.7" Margin="0,4,0,12" TextWrapping="Wrap" />

            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OverdueList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧红色竖条，与「超时」状态同色 -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Background="#E53935"
                                            VerticalAlignment="Stretch" />

                                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <!-- Run.Text 默认是 TwoWay 绑定，这里的目标是只读属性，必须显式 OneWay（否则开窗即崩） -->
                                            <Run Text="{Binding BlNo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Label, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Opacity="0.7" Margin="0,2,0,0">
                                            <Run Text="{Binding DueText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding OverdueText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="稍后处理" Margin="0,0,8,0" Click="OnSnoozeClick" />
                                        <ui:Button Content="已处理" Appearance="Primary" Click="OnHandledClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="关闭" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
