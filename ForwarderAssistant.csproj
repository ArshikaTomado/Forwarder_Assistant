<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== 基础 ========== -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 必须带 Windows 版本号：后续 Toast 的 Show()/OnActivated 才会存在 -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ForwarderAssistant</RootNamespace>
    <AssemblyName>ForwarderAssistant</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- ========== 内存 / 启动优化（对齐 ≤100MB、≤2s 红线） ========== -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- ========== 发布：自包含单文件（裸机不用装运行库，双击即跑） ========== -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    依赖（严格白名单）。
    第 0 步只放 GUI 必需的：MVVM + WPF-UI。
    其余（Microsoft.Data.Sqlite / Quartz / Tomlyn / H.NotifyIcon.Wpf /
    Microsoft.Toolkit.Uwp.Notifications）在后续步骤用到时再加，一次只引入一层风险。
    版本先用浮动号，确认可还原后再钉死具体版本。
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="WPF-UI" Version="3.*" />
    <!-- 第 1 步：本地 SQLite（Data 层）。bundle_e_sqlite3 自带原生库，单文件发布可自解压。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <!-- 提醒主力：托盘图标 + 托盘气泡（免 AUMID / 免开始菜单快捷方式，与绿色便携兼容）。 -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!-- 第 4 步：读客户给的 Excel（.xlsx）批量导入提单。只做读取，不写回。 -->
    <PackageReference Include="ClosedXML" Version="0.105.*" />
  </ItemGroup>

</Project>
